{
  "name": "anytone-codeplug-visualizer",
  "version": "1.0.6",
  "private": false,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "test": "npm run test:lib && npm run test:components",
    "dev": "vite",
    "build": "npm run check:public-data && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "format": "oxfmt",
    "demo": "python3 scripts/build_demo.py",
    "check:public-data": "node scripts/check-public-data.mjs",
    "typecheck": "tsc --noEmit",
    "test:lib": "node --test lib/codeplug.test.mjs",
    "test:components": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.41.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "oxfmt": "0.66.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "type": "module",
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
